spring.application.name=elei


# Database
# Replace with your actual database host, name, user and password
spring.datasource.url=jdbc:postgresql://localhost:5432/your_database_name
spring.datasource.username=your_database_username
spring.datasource.password=your_database_password

# use 'validate' or 'none' in production
spring.jpa.hibernate.ddl-auto=update

# Optional: log SQL queries
spring.jpa.show-sql=true


# Kafka
kafka.bootstrap-servers=${KAFKA_HOST:localhost}:9092
kafka.topics.level-up=level-up-events

# Go to Github.com -> Settings -> Developer Setting
# And Generate your client-secret key
spring.security.oauth2.client.registration.github.client-id=
spring.security.oauth2.client.registration.github.client-secret=
spring.security.oauth2.client.registration.github.scope=read:user,user:email

# Redis
spring.data.redis.host=${REDIS_HOST:localhost}
spring.data.redis.port=6379


# JWT
# Generate secret: openssl rand -base64 64
jwt.secret=your_generated_secret_key
# Time in ms (86400000 = 24 hours)
jwt.expiration=86400000

# Frontend URL (e.g. http://localhost:5173 for local Vite dev server)
app.frontend.url=
